{
  "hosting": {
    "public": "dist",
    "site": "autobusy",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/sitemap.xml",
        "headers": [
          { "key": "Cache-Control", "value": "max-age=0, trigger-zero, no-cache, no-store, must-revalidate" },
          { "key": "Content-Type", "value": "application/xml" }
        ]
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}